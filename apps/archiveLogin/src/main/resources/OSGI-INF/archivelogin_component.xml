<!--
  Declarative Services declaration of LineDJ Archive Login State application.
  component.
-->
<component xmlns="http://www.osgi.org/xmlns/scr/v1.1.0"
           name="lineDJ.CloudArchiveLoginApplication" immediate="true">
  <implementation class="de.oliver_heger.linedj.apps.archive.login.LoginApp" />

  <service>
    <provide interface="de.oliver_heger.linedj.platform.app.ClientApplication"/>
  </service>

  <reference interface="de.oliver_heger.linedj.platform.app.ClientApplicationContext"
             name="clientContext" bind="initClientContext"/>
  <reference interface="de.oliver_heger.linedj.platform.app.ApplicationManager"
             name="applicationManager" bind="initApplicationManager"/>
  <reference interface="de.oliver_heger.linedj.platform.archiveclient.ArchiveService"
             name="archiveService" bind="initArchiveService"/>
  <reference interface="de.oliver_heger.linedj.platform.archiveclient.LoginService"
             name="loginService" bind="initLoginService"/>
</component>
