<!-- The Jelly script defining the main window of the LineDJ Archive Browser
    application.
-->
<j:jelly xmlns:j="jelly:core" xmlns:di="diBuilder" xmlns:f="formBuilder"
         xmlns:a="actionBuilder" xmlns:w="windowBuilder">

  <!-- A transformer for durations. -->
  <di:bean name="durationTransformer"
           beanClassName="de.oliver_heger.linedj.platform.ui.DurationTransformer">
  </di:bean>

  <!-- Definitions for actions and their tasks -->

  <!-- The action for application shutdown -->
  <a:action name="exitAction" textres="EXIT_ACTION_TEXT"
            tooltipres="EXIT_ACTION_TOOLTIP" mnemonicres="EXIT_ACTION_MNEMO"
            resgrp="application" taskBean="exitTask"/>

  <!-- Actions for adding specific songs from the selected medium to the playlist. -->
  <a:action name="addMediumAction" textres="act_addmedium_text" tooltipres="act_addmedium_tip"
            mnemonicres="act_addmedium_mnemo" enabled="false" taskBean="addMediumTask">
    <f:icon resource="medium.png"/>
  </a:action>

  <a:action name="addArtistAction" textres="act_addartist_text" tooltipres="act_addartist_tip"
            mnemonicres="act_addartist_mnemo" enabled="false" taskBean="addArtistTask">
    <f:icon resource="artist.png"/>
  </a:action>

  <a:action name="addAlbumAction" textres="act_addalbum_text" tooltipres="act_addalbum_tip"
            mnemonicres="act_addalbum_mnemo" enabled="false" taskBean="addAlbumTask">
    <f:icon resource="album.png"/>
  </a:action>

  <a:action name="addAlbumSongsAction" textres="act_addsongs_album_text" tooltipres="act_addsongs_album_tip"
            mnemonicres="act_addsongs_album_mnemo" enabled="false" taskBean="addAlbumSongsTask">
    <f:icon resource="songs.png"/>
  </a:action>

  <a:action name="addArtistAlbumAction" textres="act_addalbum_artist_text" tooltipres="act_addalbum_artist_tip"
            mnemonicres="act_addalbum_artist_mnemo" enabled="false" taskBean="addArtistAlbumTask">
    <f:icon resource="album.png"/>
  </a:action>

  <a:action name="addArtistAlbumSongsAction" textres="act_addsongs_artist_text" tooltipres="act_addsongs_artist_tip"
            mnemonicres="act_addsongs_artist_mnemo" enabled="false" taskBean="addArtistAlbumSongsTask">
    <f:icon resource="songs.png"/>
  </a:action>

  <!-- The main menu -->
  <a:menubar name="mainMenu">
    <a:menu textres="menu_file_text" mnemonicres="menu_file_mnemo">
      <a:menuitem actionName="exitAction" acceleratorDef="ALT X"/>
    </a:menu>
    <a:menu textres="menu_add_text" mnemonicres="menu_add_mnemo">
      <a:menuitem actionName="addMediumAction"/>
      <a:menuitem actionName="addArtistAction"/>
      <a:menuitem actionName="addArtistAlbumAction"/>
      <a:menuitem actionName="addAlbumAction"/>
      <a:separator/>
      <a:menuitem actionName="addArtistAlbumSongsAction"/>
      <a:menuitem actionName="addAlbumSongsAction"/>
    </a:menu>
  </a:menubar>

  <!-- Models for UI controls -->

  <!-- The model of the artists tree. -->
  <di:bean name="artistsTreeModel"
           beanClassName="org.apache.commons.configuration.HierarchicalConfiguration">
    <di:setProperty property="expressionEngine">
      <di:bean beanClassName="org.apache.commons.configuration.tree.DefaultExpressionEngine">
        <di:setProperty property="propertyDelimiter" value="|"/>
      </di:bean>
    </di:setProperty>
  </di:bean>

  <!-- The model of the artist song table. -->
  <di:bean name="artistSongsTableModel" beanClassName="java.util.ArrayList"/>

  <!-- The model of the albums table. -->
  <di:bean name="albumsTableModel" beanClassName="java.util.ArrayList"/>

  <!-- The model of the table with the songs of an album. -->
  <di:bean name="albumSongsTableModel" beanClassName="java.util.ArrayList"/>

  <!-- The model for the media combo box. -->
  <di:bean name="mediaComboModel"
           beanClassName="de.oliver_heger.linedj.apps.archive.browser.EmptyMediumListModel"/>

  <!-- Message bus registration -->
  <di:bean name="LineDJ_messageBusRegistration"
           beanClassName="de.oliver_heger.linedj.platform.bus.MessageBusRegistration">
    <di:constructor>
      <di:param>
        <di:list>
          <di:element refName="albumSongsLoader"/>
          <di:element refName="artistSongsLoader"/>
          <di:element refName="mediaController"/>
        </di:list>
      </di:param>
    </di:constructor>
    <di:setProperty property="messageBus" refName="LineDJ_MessageBus"/>
    <di:shutdown>
      <di:methodInvocation method="removeRegistrations"/>
    </di:shutdown>
  </di:bean>

  <!-- Handlers for popup menus. -->
  <di:bean name="artistPopupHandler"
           beanClassName="de.oliver_heger.linedj.apps.archive.browser.ArtistPopupHandler"/>

  <!-- The main window -->
  <w:frame titleres="main_title" menu="mainMenu">
    <f:icon resource="app_icon.png"/>
    <f:borderlayout canShrink="false"/>

    <!-- The main panel. -->
    <f:panel>
      <f:borderconstr name="CENTER"/>
      <f:borderlayout canShrink="true"/>
      <f:panel>
        <f:borderconstr name="NORTH"/>
        <f:borderlayout leftMargin="5" rightMargin="5" topMargin="4"
                        bottomMargin="4" westGap="8" eastGap="8"/>
        <f:label textres="media_lab_media">
          <f:borderconstr name="WEST"/>
        </f:label>
        <f:combo name="comboMedia" modelRef="mediaComboModel">
          <f:borderconstr name="CENTER"/>
        </f:combo>
      </f:panel>

      <f:tabbedpane>
        <f:borderconstr name="CENTER"/>
        <f:tab titleres="tab_artists">
          <f:panel>
            <f:borderlayout/>
            <!-- The toolbar for the Artists tab. -->
            <a:toolbar>
              <f:borderconstr name="NORTH"/>
              <a:toolbutton actionName="addMediumAction"/>
              <a:toolbutton actionName="addArtistAction"/>
              <a:toolbutton actionName="addArtistAlbumAction"/>
              <a:separator/>
              <a:toolbutton actionName="addArtistAlbumSongsAction"/>
            </a:toolbar>
            <f:splitter orientation="horizontal" resizeWeight="0.25">
              <f:borderconstr name="CENTER"/>
              <f:tree name="treeArtists" model="artistsTreeModel" editable="false"
                      scrollWidth="2cm" scrollHeight="3cm" multiSelection="false"
                      rootVisible="true">
                <a:popup beanName="artistPopupHandler"/>
              </f:tree>

              <f:table name="tableArtistSongs" model="artistSongsTableModel" multiSelection="true">
                <f:borderconstr name="CENTER"/>
                <f:column name="artist" percentWidth="35"
                          headerres="tcol_song_artist">
                </f:column>
                <f:column name="title" percentWidth="40" headerres="tcol_song_title"
                          columnClass="String"/>
                <f:column name="trackNumber" percentWidth="10" headerres="tcol_song_track"/>
                <f:column name="duration" percentWidth="15" headerres="tcol_song_duration">
                  <f:transformer type="write" beanName="durationTransformer"/>
                </f:column>
                <a:popup beanName="artistPopupHandler"/>
              </f:table>
            </f:splitter>
          </f:panel>
        </f:tab>

        <f:tab titleres="tab_albums">
          <f:panel>
            <f:borderlayout/>
            <!-- The toolbar for the Albums tab. -->
            <a:toolbar>
              <f:borderconstr name="NORTH"/>
              <a:toolbutton actionName="addMediumAction"/>
              <a:toolbutton actionName="addAlbumAction"/>
              <a:separator/>
              <a:toolbutton actionName="addAlbumSongsAction"/>
            </a:toolbar>
            <f:splitter orientation="horizontal" resizeWeight="0.25">
              <f:borderconstr name="CENTER"/>
              <f:table name="tableAlbums" model="albumsTableModel">
                <f:borderconstr name="CENTER"/>
                <f:column name="title" percentWidth="40" headerres="tcol_song_title"
                          columnClass="String"/>
                <f:column name="artist" percentWidth="35"
                          headerres="tcol_song_artist"/>
              </f:table>

              <f:table name="tableAlbumSongs" model="albumSongsTableModel" multiSelection="true">
                <f:borderconstr name="CENTER"/>
                <f:column name="artist" percentWidth="35"
                          headerres="tcol_song_artist">
                </f:column>
                <f:column name="title" percentWidth="40" headerres="tcol_song_title"
                          columnClass="String"/>
                <f:column name="trackNumber" percentWidth="10" headerres="tcol_song_track"/>
                <f:column name="duration" percentWidth="15" headerres="tcol_song_duration">
                  <f:transformer type="write" beanName="durationTransformer"/>
                </f:column>
              </f:table>
            </f:splitter>
          </f:panel>
        </f:tab>
      </f:tabbedpane>
    </f:panel>

    <!-- Status line -->
    <f:panel>
      <f:borderconstr name="SOUTH"/>
      <f:borderlayout canShrink="false"/>
      <f:label name="mediaLoadingIndicator">
        <f:icon resource="loading.gif"/>
        <f:borderconstr name="WEST"/>
      </f:label>
      <f:statictext name="txtStatusLine">
        <f:borderconstr name="CENTER"/>
      </f:statictext>
    </f:panel>

    <!-- The controller for the status line. -->
    <di:bean name="statusLineController"
             beanClassName="de.oliver_heger.linedj.apps.archive.browser.StatusLineController">
      <di:constructor>
        <di:param refName="jguiraffe.applicationContext"/>
        <di:param refName="comp:txtStatusLine"/>
        <di:param refName="widget:mediaLoadingIndicator"/>
      </di:constructor>
    </di:bean>

    <!-- The loader for songs on a specific album. -->
    <di:bean name="albumSongsLoader"
             beanClassName="de.oliver_heger.linedj.apps.archive.browser.SongsLoader">
      <di:constructor>
        <di:param refName="archiveService"/>
        <di:param refName="LineDJ_ExecutionContext"/>
        <di:param refName="LineDJ_MessageBus"/>
        <di:param refName="statusLineController"/>
        <di:param value="/api/archive/media/{mediumID}/albums"/>
        <di:param value="stat_album_loading"/>
      </di:constructor>
    </di:bean>

    <!-- The loader for songs from a specific artist. -->
    <di:bean name="artistSongsLoader"
             beanClassName="de.oliver_heger.linedj.apps.archive.browser.SongsLoader">
      <di:constructor>
        <di:param refName="archiveService"/>
        <di:param refName="LineDJ_ExecutionContext"/>
        <di:param refName="LineDJ_MessageBus"/>
        <di:param refName="statusLineController"/>
        <di:param value="/api/archive/media/{mediumID}/artists"/>
        <di:param value="stat_artist_loading"/>
      </di:constructor>
    </di:bean>

    <!-- The controller of the main window. -->
    <di:bean name="mediaController"
             beanClassName="de.oliver_heger.linedj.apps.archive.browser.Controller">
      <di:constructor>
        <di:param refName="albumSongsLoader"/>
        <di:param refName="artistSongsLoader"/>
        <di:param refName="comp:comboMedia"/>
        <di:param refName="comp:treeArtists"/>
        <di:param refName="comp:tableArtistSongs"/>
        <di:param refName="comp:tableAlbums"/>
        <di:param refName="comp:tableAlbumSongs"/>
      </di:constructor>

      <di:methodInvocation method="initialize"/>
      <di:shutdown>
        <di:methodInvocation method="destroy"/>
      </di:shutdown>
    </di:bean>

    <w:controller beanName="mediaController"/>
  </w:frame>

  <!-- Selection change listener for media controls. -->
  <di:bean name="mediaSelectionChangeListener"
           beanClassName="de.oliver_heger.linedj.apps.archive.browser.SelectionChangeHandler">
    <di:constructor>
      <di:param refName="mediaController"/>
      <di:param refName="ACTION_STORE"/>
    </di:constructor>
  </di:bean>

  <a:eventListener component="comboMedia" eventType="CHANGE" beanName="mediaSelectionChangeListener"/>
  <a:eventListener component="treeArtists" eventType="CHANGE" beanName="mediaSelectionChangeListener"/>
  <a:eventListener component="tableAlbums" eventType="CHANGE" beanName="mediaSelectionChangeListener"/>
  <a:eventListener component="tableAlbumSongs" eventType="CHANGE" beanName="mediaSelectionChangeListener"/>
  <a:eventListener component="tableArtistSongs" eventType="CHANGE" beanName="mediaSelectionChangeListener"/>

  <!-- Action tasks and commands -->

  <!-- The action task for quitting the application -->
  <di:bean name="exitTask"
           beanClassName="net.sf.jguiraffe.gui.app.ApplicationShutdownActionTask">
  </di:bean>

  <!-- Action tasks for adding songs to the playlist. -->
  <di:bean name="addMediumTask" beanClassName="de.oliver_heger.linedj.apps.archive.browser.AppendMediumSongsTask">
    <di:constructor>
      <di:param refName="archiveService"/>
      <di:param refName="LineDJ_ExecutionContext"/>
      <di:param refName="LineDJ_MessageBus"/>
      <di:param refName="comp:comboMedia"/>
    </di:constructor>
  </di:bean>

  <di:bean name="addArtistTask" beanClassName="de.oliver_heger.linedj.apps.archive.browser.AppendArtistSongsTask">
    <di:constructor>
      <di:param refName="archiveService"/>
      <di:param refName="LineDJ_ExecutionContext"/>
      <di:param refName="LineDJ_MessageBus"/>
      <di:param refName="comp:treeArtists"/>
      <di:param refName="comp:comboMedia"/>
    </di:constructor>
  </di:bean>

  <di:bean name="addAlbumTask" beanClassName="de.oliver_heger.linedj.apps.archive.browser.AppendTableSongsTask">
    <di:constructor>
      <di:param refName="LineDJ_MessageBus"/>
      <di:param refName="comp:tableAlbumSongs"/>
      <di:param value="false"/>
    </di:constructor>
  </di:bean>

  <di:bean name="addAlbumSongsTask" beanClassName="de.oliver_heger.linedj.apps.archive.browser.AppendTableSongsTask">
    <di:constructor>
      <di:param refName="LineDJ_MessageBus"/>
      <di:param refName="comp:tableAlbumSongs"/>
      <di:param value="true"/>
    </di:constructor>
  </di:bean>

  <di:bean name="addArtistAlbumTask" beanClassName="de.oliver_heger.linedj.apps.archive.browser.AppendTableSongsTask">
    <di:constructor>
      <di:param refName="LineDJ_MessageBus"/>
      <di:param refName="comp:tableArtistSongs"/>
      <di:param value="false"/>
    </di:constructor>
  </di:bean>

  <di:bean name="addArtistAlbumSongsTask" beanClassName="de.oliver_heger.linedj.apps.archive.browser.AppendTableSongsTask">
    <di:constructor>
      <di:param refName="LineDJ_MessageBus"/>
      <di:param refName="comp:tableArtistSongs"/>
      <di:param value="true"/>
    </di:constructor>
  </di:bean>
</j:jelly>
